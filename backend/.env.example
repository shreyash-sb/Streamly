# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (Optional for instant video calling, required for persistent accounts & history)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/streamly?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=streamly_super_secure_access_token_secret_key_change_in_production
JWT_REFRESH_SECRET=streamly_super_secure_refresh_token_secret_key_change_in_production

# Optional: LLM Meeting Summary (Gemini / OpenAI / Groq)
# If left empty, Streamly automatically uses its free built-in Extractive NLP Summarizer!
LLM_API_KEY=
LLM_ENDPOINT=

# Optional: STUN / TURN Server Configuration (e.g. Metered.ca free tier or self-hosted coturn)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
